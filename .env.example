# ingestd (docs/PLAN.md §14.1). Copy to .env / .env.kind; never commit either.
INGESTD_RECIPES=./recipes
INGESTD_SINK=fs                 # fs | s3
INGESTD_OUT=./data/raw          # fs sink root (the PVC mount on kind)
INGESTD_BUCKET=                 # s3 sink bucket
INGESTD_PREFIX=                 # optional key prefix
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=              # kind only; EKS uses Pod Identity
AWS_SECRET_ACCESS_KEY=
INGESTD_WORKERS=8
INGESTD_SHUTDOWN_GRACE=45s
INGESTD_AS_OF=2026-09-01        # committed runs pin this; omit for today
INGESTD_SCHEDULE=               # e.g. 15m
INGESTD_LOG_LEVEL=info
EVENTIDE_API_KEY=eventide-demo-key   # the api_key source secret (also what mocksources expects)
MOCKSOURCES_URL=http://127.0.0.1:18081

# Databricks bundle / Redshift loader
DATABRICKS_HOST=
DATABRICKS_TOKEN=
REDSHIFT_WORKGROUP=rates-wg
REDSHIFT_DATABASE=rates
REDSHIFT_IAM_ROLE=
