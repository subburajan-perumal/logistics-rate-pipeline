{
  "source_id": "corvus",
  "carrier": "CORVUS",
  "url": "${MOCKSOURCES_URL}/corvus/export.csv",
  "format": "csv",
  "columns": {
    "origin_raw": "origin", "destination_raw": "destination",
    "container_type_raw": "size", "price_raw": "teu_rate",
    "currency": "currency", "unit": "per_teu",
    "valid_from_raw": "valid_from", "valid_to_raw": "valid_to"
  },
  "hints": {"decimal_style": "us", "date_layout": "2006-01-02"},
  "timeout": "20s",
  "retry": {"max_attempts": 4, "base_backoff": "250ms", "max_backoff": "5s"},
  "rate_limit_rps": 10
}
